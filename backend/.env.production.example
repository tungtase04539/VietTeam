# Production Environment Variables (Vercel + Supabase)

# Supabase Database URL
# Format: postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:your-supabase-password@db.xxxxxxxxxxxxxx.supabase.co:5432/postgres?pgbouncer=true"

# Direct connection (for migrations)
DIRECT_URL="postgresql://postgres:your-supabase-password@db.xxxxxxxxxxxxxx.supabase.co:5432/postgres"

# JWT Secret (generate a strong random string)
JWT_SECRET=your_very_strong_secret_key_for_production_minimum_32_characters

# JWT Expiration
JWT_EXPIRES_IN=7d

# Node Environment
NODE_ENV=production

# Port (for local testing, Vercel will use its own port)
PORT=5000
